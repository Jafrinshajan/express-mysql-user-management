
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>All Users</title>
</head>

<style>
    table, th, td {
        border: 1px solid #ccc;
    }
</style>

<body>
    <table>
        <tr>
            <th>ID</th>
            <th>Username</th>
            <th>Email</th>
            <th>Password</th>
            <th>Edit</th>
            <th>Delete</th>
        </tr>

        <% for (user of users) { %>
        <tr>
            <td><%= user.id %></td>
            <td><%= user.username %></td>
            <td><%= user.email %></td>
            <td><%= user.password %></td>

            <td>
                <form action="/user/<%= user.id %>/edit" method="GET">
                    <button type="submit">Edit User</button>
                </form>
            </td>

            <td>
                <form action="/user/<%= user.id %>?_method=DELETE" method="POST">
                    <button type="submit"
                        onclick="return confirm('Are you sure you want to delete this user?')">
                        Delete User
                    </button>
                </form>
            </td>
        </tr>
        <% } %>
    </table>
</body>
</html>
